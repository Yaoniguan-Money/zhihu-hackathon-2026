  "evidence_catalog": [
    {
      "evidence_id": "ev-1",
      "type": "quote",
      "title": "现收现付制说明",
      "body": "中国现在的养老金制度是“现收现付制”。你现在交的钱，正在发给现在已经退休的人。等你退休了，那时候还在工作的年轻人交的钱，才会发给你。",
      "public_claim_refs": [
        "cl-4",
        "cl-5",
        "cl-6"
      ],
      "conflicts_with": []
    },
    {
      "evidence_id": "ev-2",
      "type": "source",
      "title": "人口结构数据",
      "body": "中国60岁及以上人口已经超过3亿。劳动年龄人口（16-59岁）从2012年开始就在持续下降。",
      "public_claim_refs": [
        "cl-9",
        "cl-10"
      ],
      "conflicts_with": []
    },
    {
      "evidence_id": "ev-3",
      "type": "claim",
      "title": "替代率定义与现状",
      "body": "养老金替代率 = 退休后每月领的养老金 ÷ 退休前的月工资。你退休前月薪1万，退休后每个月领4000，替代率就是40%。2026年，中国养老金的平均替代率大概在40%左右。",
      "public_claim_refs": [
        "cl-14",
        "cl-15",
        "cl-16"
      ],
      "conflicts_with": []
    },
    {
      "evidence_id": "ev-4",
      "type": "contradiction",
      "title": "关于2026年领不到养老金的谣言",
      "body": "网上那些“2026年领不到养老金”的说法，人社部早已辟谣，纯属谣言。",
      "public_claim_refs": [
        "cl-24"
      ],
      "conflicts_with": []
    },
    {
      "evidence_id": "ev-5",
      "type": "timeline",
      "title": "延迟退休实施时间表",
      "body": "2025年1月1日起，中国开始实施渐进式延迟退休，不是一步到位。男职工：原法定退休年龄60岁，每4个月延1个月，最终到63岁（过渡期15年）。女职工（原50岁退休）：每2个月延1个月，最终到55岁。女干部（原55岁退休）：每4个月延1个月，最终到58岁。如果你是1966年出生的男性，你在2026年退休，你的退休年龄是60岁零3个月。网上那些“2026年直接63岁退休”“坏消息！退休人员苦日子来了”之类的说法，完全是两回事。",
      "public_claim_refs": [
        "cl-29",
        "cl-30",
        "cl-31",
        "cl-32",
        "cl-33",
        "cl-34"
      ],
      "conflicts_with": []
    },
    {
      "evidence_id": "ev-6",
      "type": "claim",
      "title": "三支柱养老体系",
      "body": "2026年，中国的养老保障体系正在从“单腿跳”走向“三条腿走路”。覆盖超过10亿人，是全球最大的养老保障网。作用是“保基本”，不是“保体面”。2022年开始试点，2024年推向全国。每个人可以开一个个人养老金账户，每年最高缴存12000元，享受税收优惠。",
      "public_claim_refs": [
        "cl-50",
        "cl-51",
        "cl-52",
        "cl-55",
        "cl-56"
      ],
      "conflicts_with": []
    },
    {
      "evidence_id": "ev-7",
      "type": "quote",
      "title": "自媒体套路警示",
      "body": "大量自媒体用“坏消息！！”“紧急通知！！！”做标题，收割流量。拿真实政策中的一小部分，放大、扭曲、制造恐慌。把“渐进式延迟”说成“一步到位”，把“缴费年限逐步延长”说成“突然变20年”。",
      "public_claim_refs": [
        "cl-62",
        "cl-63",
        "cl-64"
      ],
      "conflicts_with": []
    },
    {
      "evidence_id": "ev-8",
      "type": "contradiction",
      "title": "养老金缴费年限的谣传与事实",
      "body": "2025年到2029年退休的人，最低缴费年限仍然是15年，不变。从2030年开始，才会用10年时间每年增加6个月，逐步从15年提高到20年（到2039年才正式到20年）。养老金不是“交够15年就行了”。",
      "public_claim_refs": [
        "cl-37",
        "cl-38",
        "cl-68"
      ],
      "conflicts_with": []
    },
    {
      "evidence_id": "ev-9",
      "type": "claim",
      "title": "个人养老责任与规划",
      "body": "以前是“国家兜底”，以后是“国家兜底+个人努力”。真正的养老规划，是多元的：社保打底，存款保底，投资增厚，健康是最大的本钱。",
      "public_claim_refs": [
        "cl-60",
        "cl-77"
      ],
      "conflicts_with": []
    },
    {
      "evidence_id": "ev-10",
      "type": "quote",
      "title": "养老焦虑的来源",
      "body": "你问焦虑从哪来？从这40%来。40%的替代率，确实不足以支撑一个体面的退休生活。",
      "public_claim_refs": [
        "cl-20",
        "cl-28"
      ],
      "conflicts_with": []
    },
    {
      "evidence_id": "ev-11",
      "type": "claim",
      "title": "焦虑的商机与反思",
      "body": "焦虑是真实的。但焦虑被定价了，被人利用了。“等退休是场骗局”这个说法，我不完全同意。它让很多人开始正视自己的养老问题，这是好事。",
      "public_claim_refs": [
        "cl-65",
        "cl-78",
        "cl-79"
      ],
      "conflicts_with": []
    }
  ],
